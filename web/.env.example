# LLM provider 선택: mock | anthropic | openai | google
# 기본값은 mock — 키가 없거나 미설정이면 자동으로 mock 으로 폴백됩니다.
LLM_PROVIDER=mock

# Anthropic (LLM_PROVIDER=anthropic 일 때만 사용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (LLM_PROVIDER=openai 일 때만 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (LLM_PROVIDER=google 일 때만 사용)
# 키 발급: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
